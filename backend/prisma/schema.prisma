  code        String?           // e.g. "CMATHS", "PHYSICS"
  categoryId  Int?
  category    LibraryCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  streamId    Int?
  stream      LibraryStream?    @relation(fields: [streamId], references: [id], onDelete: SetNull)
  gradeId     Int?
  grade       LibraryGrade?     @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  sortOrder   Int               @default(0)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  resources   LibraryResource[]
}

model LibraryResource {
  id                Int               @id @default(autoincrement())
  title             String            // e.g. "2027 A/L Combined Maths Model Paper 01 + Scheme"
  description       String?           @db.Text
  fileUrl           String            // Path or URL to PDF file (e.g. "/uploads/library/1788...pdf")
  fileName          String?
  fileSize          String?           // e.g. "2.4 MB"
  fileType          String            @default("PDF") // PDF, DOCX, etc.
  resourceType      String            @default("PAST_PAPER") // PAST_PAPER, MODEL_PAPER, TEACHERS_GUIDE, SHORT_NOTE, TERM_TEST
  year              String?           // e.g. "2027", "2026", "2025"
  term              String?           // e.g. "1st Term", "2nd Term", "3rd Term", "Final"
  medium            String            @default("SINHALA") // SINHALA, ENGLISH, TAMIL
  hasMarkingScheme  Boolean           @default(false)
  markingSchemeUrl  String?
  tags              String?           // comma-separated keywords
  downloadCount     Int               @default(0)
  viewCount         Int               @default(0)
  isFeatured        Boolean           @default(false)
  isPublished       Boolean           @default(true)

  categoryId        Int?
  category          LibraryCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  gradeId           Int?
  grade             LibraryGrade?     @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  streamId          Int?
  stream            LibraryStream?    @relation(fields: [streamId], references: [id], onDelete: SetNull)
  subjectId         Int?
  subject           LibrarySubject?   @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  createdById       Int?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model MissedCallTask {
  id                    Int       @id @default(autoincrement())
  callLogId             String?
  phone                 String
  studentName           String?
  businessId            Int
  business              Business  @relation(fields: [businessId], references: [id])
  batchId               Int?
  batch                 Batch?    @relation(fields: [batchId], references: [id])
  callTime              DateTime
  source                String    @default("CRM") // FREE_SEMINAR, AFTER_SEMINAR, GENERAL
  
  // Read-only reference to who owns the lead currently in CRM
  existingLeadId        Int?
  existingAssigneeId    Int?
  existingAssigneeName  String?

  // Task Assignment (Isolated from Lead table)
  taskAssigneeId        Int?
  taskAssignee          User?     @relation("MissedCallTaskAssignee", fields: [taskAssigneeId], references: [id])
  assignedByManagerId   Int?
  assignedByManager     User?     @relation("MissedCallTaskAssignedBy", fields: [assignedByManagerId], references: [id])
  assignedAt            DateTime?

  taskDate              String    // Format: YYYY-MM-DD (e.g., 2026-09-08)
  status                String    @default("PENDING_DISTRIBUTION") // PENDING_DISTRIBUTION, ASSIGNED, COMPLETED, RESOLVED

  // Staff Follow-up Results
  callOutcome           String?   // PENDING, ANSWERED, NO_ANSWER, REJECTED, CALL_AGAIN
  callAttempts          Int       @default(0)
  remarks               String?   @db.Text
  lastAttemptAt         DateTime?
  completedAt           DateTime?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([businessId, taskDate])
  @@index([taskAssigneeId, status])
  @@index([phone])
}

model WhatsappRotator {
  id          Int      @id @default(autoincrement())
  campaign    String   @default("default") // Campaign identifier (e.g. "default", "commerce", "batch2026")
  name        String   // Display name, e.g. "Community 01"
  inviteUrl   String   @db.Text // https://chat.whatsapp.com/...
  clickCount  Int      @default(0) // Total scan/redirect counter
  maxLimit    Int      @default(1020) // Auto-switch limit (WhatsApp group threshold)
  isActive    Boolean  @default(true) // Whether this link is currently accepting users
  orderIndex  Int      @default(1) // Priority order (1 -> 2 -> 3...)
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([campaign, isActive, orderIndex])
}

// ==========================================
// PETTY CASH MANAGEMENT SYSTEM MODELS
// ==========================================

model PettyCashAccount {
  id                  Int      @id @default(autoincrement())
  businessId          Int      @unique
  business            Business @relation(fields: [businessId], references: [id])
  fundLimit           Float    @default(50000.0) // Max allocated petty cash fund limit
  currentBalance      Float    @default(0.0)     // Actual available petty cash balance
  minBalanceThreshold Float    @default(10000.0) // Minimum threshold triggering reload warning
  status              String   @default("ACTIVE") // ACTIVE, SUSPENDED
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  transactions        PettyCashTransaction[]
  reloads             PettyCashReload[]

  @@index([businessId, status])
}

model PettyCashTransaction {
  id                    Int               @id @default(autoincrement())
  transactionNo         String            @unique // Unique ID: e.g. PCT-2026-0001
  
  businessId            Int
  business              Business          @relation(fields: [businessId], references: [id])
  accountId             Int
  account               PettyCashAccount  @relation(fields: [accountId], references: [id])
  
  requesterId           Int
  requester             User              @relation("PettyCashRequester", fields: [requesterId], references: [id])

  status                String            @default("PENDING_APPROVAL") 
  // PENDING_APPROVAL, APPROVED, REJECTED, RETURNED_FOR_CHANGES, CASH_ISSUED, CASH_RECEIVED, RECEIPT_SUBMITTED, RETURNED_FOR_CORRECTION, VERIFIED, SETTLED

  // 1. Request Details
  category              String            // OFFICE_SUPPLIES, REFRESHMENTS, TRAVEL, REPAIRS, MARKETING, UTILITIES, OTHER
  requestedAmount       Float
  purpose               String            @db.Text
  requiredDate          DateTime
  additionalNotes       String?           @db.Text
  requestSlipNo         String?           // e.g. REQ-ESLIP-0001
  requestedAt           DateTime          @default(now())

  // 2. Admin Manager Approval Details
  adminManagerId        Int?
  adminManager          User?             @relation("PettyCashAdminManager", fields: [adminManagerId], references: [id])
  approvedAmount        Float?
  approvalComments      String?           @db.Text
  rejectionReason       String?           @db.Text
  returnForChangesNote  String?           @db.Text
  approvalSlipNo        String?           // e.g. APP-ESLIP-0001
  approvedAt            DateTime?

  // 3. Cash Issue Details
  issuedByOfficerId     Int?
  issuedByOfficer       User?             @relation("PettyCashIssuedBy", fields: [issuedByOfficerId], references: [id])
  cashIssuedAmount      Float?
  cashIssueSlipNo       String?           // e.g. ISS-ESLIP-0001
  cashIssuedAt          DateTime?
  
  // Digital Confirmation of Cash Received by Manager
  cashReceivedConfirmed Boolean           @default(false)
  cashReceivedAt         DateTime?

  // 4. Expense & Mandatory Receipt Details
  actualSpentAmount     Float?
  cashReturnedAmount    Float?            @default(0.0) // Difference: cashIssuedAmount - actualSpentAmount
  receiptNo             String?
  vendorName            String?
  expenseDate           DateTime?
  expenseDescription    String?           @db.Text
  receiptAttachment     String?           // Path to uploaded receipt/invoice file
  receiptSubmittedAt    DateTime?

  // 5. Receipt Verification & Settlement Details
  verifiedByOfficerId   Int?
  verifiedByOfficer     User?             @relation("PettyCashVerifiedBy", fields: [verifiedByOfficerId], references: [id])
  verificationComments  String?           @db.Text
  returnCorrectionNote  String?           @db.Text
  verifiedAt            DateTime?
  finalSettlementSlipNo String?           // e.g. SET-ESLIP-0001
  settledAt             DateTime?

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  auditLogs             PettyCashAuditLog[]

  @@index([businessId, status])
  @@index([requesterId, status])
  @@index([status])
}

model PettyCashReload {
  id               Int              @id @default(autoincrement())
  reloadNo         String           @unique // e.g. PCR-2026-0001
  businessId       Int
  business         Business         @relation(fields: [businessId], references: [id])
  accountId        Int
  account          PettyCashAccount @relation(fields: [accountId], references: [id])
  amount           Float
  previousBalance  Float
  newBalance       Float
  performedById    Int
  performedBy      User             @relation("PettyCashReloadPerformedBy", fields: [performedById], references: [id])
  notes            String?          @db.Text
  createdAt        DateTime         @default(now())

  @@index([businessId])
  @@index([accountId])
}

model PettyCashAuditLog {
  id             Int                   @id @default(autoincrement())
  transactionId  Int?
  transaction    PettyCashTransaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  userId         Int?
  user           User?                 @relation("PettyCashAuditUser", fields: [userId], references: [id])
  userName       String
  userRole       String
  action         String                // REQUEST_CREATED, REQUEST_APPROVED, REQUEST_REJECTED, REQUEST_RETURNED, CASH_ISSUED, CASH_CONFIRMED, RECEIPT_SUBMITTED, RECEIPT_RETURNED, RECEIPT_VERIFIED, TRANSACTION_SETTLED, FUND_RELOADED
  previousStatus String?
  newStatus      String?
  comments       String?               @db.Text
  createdAt      DateTime              @default(now())

  @@index([transactionId])
  @@index([userId])
  @@index([action])
}
