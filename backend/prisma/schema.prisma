model Paper {
  id                        Int               @id @default(autoincrement())
  contentId                 Int               @unique
  content                   Content           @relation(fields: [contentId], references: [id], onDelete: Cascade)
  paperType                 String            @default("MCQ") // "MCQ", "STRUCTURED", or "BOTH"
  timerMode                 String            @default("FLEXIBLE") // "SCHEDULED" or "FLEXIBLE"
  scheduledStartTime        DateTime?
  mcqTimerMode              String            @default("FLEXIBLE") // "SCHEDULED" or "FLEXIBLE"
  mcqScheduledStartTime     DateTime?
  structuredTimerMode       String            @default("FLEXIBLE") // "SCHEDULED" or "FLEXIBLE"
  structuredScheduledStartTime DateTime?
  breakIntervalMinutes      Int?              @default(15)
  structuredUploadMinutes   Int?              @default(15)
  durationMinutes           Int               @default(60)
  mcqDurationMinutes        Int?              @default(30)
  structuredDurationMinutes Int?              @default(60)
  totalMarks                Float?            @default(100)
  totalMcqMarks             Float?            @default(50)
  totalStructuredMarks      Float?            @default(50)
  passMarks                 Float?            @default(40)
  instructions              String?           @db.Text
  gradingScale              String?           @db.Text
  mcqPaperFile              String?
  structuredPaperFile       String?
  category                  String            @default("WEEKLY") // "WEEKLY" or "MONTHLY"
  hasLeaderboard            Boolean           @default(true)
  manualParticipantCount    Int?              // Staff-entered participant count
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  questions                 PaperQuestion[]
  submissions               PaperSubmission[]
}

model PaperQuestion {
  id           Int                     @id @default(autoincrement())
  paperId      Int
  paper        Paper                   @relation(fields: [paperId], references: [id], onDelete: Cascade)
  questionNo   Int
  questionText String                  @db.Text
  image        String?                 @db.Text
  marks        Float                   @default(1.0)
  createdAt    DateTime                @default(now())

  options      PaperOption[]
  answers      PaperSubmissionAnswer[]
}

model PaperOption {
  id         Int                     @id @default(autoincrement())
  questionId Int
  question   PaperQuestion           @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionNo   Int                     // 1, 2, 3, 4, 5
  optionText String                  @db.Text
  isCorrect  Boolean                 @default(false)

  answers    PaperSubmissionAnswer[]
}

model PaperSubmission {
  id                    Int                     @id @default(autoincrement())
  paperId               Int
  paper                 Paper                   @relation(fields: [paperId], references: [id], onDelete: Cascade)
  studentId             Int
  student               User                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  startedAt             DateTime                @default(now())
  submittedAt           DateTime?
  mcqSubmittedAt        DateTime?
  structuredStartedAt   DateTime?
  structuredSubmittedAt DateTime?
  isUploadLocked        Boolean                 @default(false)
  status                String                  @default("IN_PROGRESS") // "IN_PROGRESS", "SUBMITTED", "PENDING_EVALUATION", "GRADED"
  score                 Float?                  @default(0)
  mcqScore              Float?                  @default(0)
  structuredScore       Float?                  @default(0)
  totalQuestions        Int?                    @default(0)
  correctAnswers        Int?                    @default(0)
  answerFile            String?                 // For structured paper (PDF upload)
  answerImages          String?                 @db.Text // JSON array of uploaded image filenames for structured paper
  teacherFeedback       String?                 @db.Text
  gradedBy              Int?                    // User ID of the Paper Marker / Lecturer
  gradedAt              DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  answers         PaperSubmissionAnswer[]

  @@unique([paperId, studentId])
}

model PaperSubmissionAnswer {
  id               Int             @id @default(autoincrement())
  submissionId     Int
  submission       PaperSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId       Int
  question         PaperQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId Int?
  selectedOption   PaperOption?    @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)
  isCorrect        Boolean         @default(false)
}

